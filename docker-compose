services:
  worker-base-build:
    build:
      context: .
      dockerfile: worker-base/Dockerfile
    image: multica-worker-base:latest
    profiles: ["build-only"]

  worker-codex:
    build:
      context: .
      dockerfile: worker-codex/Dockerfile
    container_name: multica-worker-codex
    restart: unless-stopped
    environment:
      MULTICA_SERVER_URL: ${MULTICA_SERVER_URL}
      MULTICA_APP_URL: ${MULTICA_APP_URL}
      MULTICA_TOKEN: ${MULTICA_CODEX_TOKEN}
      DEVICE_NAME: worker-codex-01
      OPENAI_API_KEY: ${OPENAI_API_KEY}
    volumes:
      - codex_multica_home:/root/.multica
      - ./workspaces/codex:/workspace
    depends_on:
      - worker-base-build

  worker-claude:
    build:
      context: .
      dockerfile: worker-claude/Dockerfile
    container_name: multica-worker-claude
    restart: unless-stopped
    environment:
      MULTICA_SERVER_URL: ${MULTICA_SERVER_URL}
      MULTICA_APP_URL: ${MULTICA_APP_URL}
      MULTICA_TOKEN: ${MULTICA_CLAUDE_TOKEN}
      DEVICE_NAME: worker-claude-01
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
    volumes:
      - claude_multica_home:/root/.multica
      - ./workspaces/claude:/workspace
    depends_on:
      - worker-base-build

volumes:
  codex_multica_home:
  claude_multica_home: